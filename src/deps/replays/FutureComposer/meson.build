  'libtfmxaudiodecoder/src/Chris/Pattern.cpp',
  'libtfmxaudiodecoder/src/Chris/SamplesFile.cpp',
  'libtfmxaudiodecoder/src/Chris/Sequencer.cpp',
  'libtfmxaudiodecoder/src/Chris/Songs.cpp',
  'libtfmxaudiodecoder/src/Chris/TFMXDecoder.cpp',
  'libtfmxaudiodecoder/src/Decoder.cpp',
  'libtfmxaudiodecoder/src/DecoderProxy.cpp',
  'libtfmxaudiodecoder/src/Dump.cpp',
  'libtfmxaudiodecoder/src/Filter.cpp',
  'libtfmxaudiodecoder/src/Jochen/Analyze.cpp',
  'libtfmxaudiodecoder/src/Jochen/COSO.cpp',
  'libtfmxaudiodecoder/src/Jochen/Envelope.cpp',
  'libtfmxaudiodecoder/src/Jochen/FC.cpp',
