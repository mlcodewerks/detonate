spessa_inc = include_directories('spessasynth/include')
spessa = static_library('spessasynth', spessa_sources,
  include_directories: [spessa_inc, include_directories('spessasynth/src', 'spessasynth/include/spessasynth/sflist', 'spessasynth/extern/json')],
  dependencies: [zlib, math, threads], c_args: common_flags + ['-DSS_HAVE_ZLIB=1'],
  gnu_symbol_visibility: 'hidden', override_options: ['warning_level=0'])
mu_inc = include_directories('s_mu2000/src', 's_mu2000/src/compat')
mu2000 = static_library('smu2000', mu_sources, include_directories: mu_inc,
  dependencies: [threads, math], cpp_args: common_flags,
  gnu_symbol_visibility: 'hidden', override_options: ['warning_level=0'])
emu88_inc = include_directories('gearmulator/source', 'gearmulator/source/cpu',
  'gearmulator/source/framework', 'gearmulator/source/ronaldo',
  'gearmulator/source/ronaldo/88emu', 'gearmulator/source/ronaldo/custom_chips',
  'gearmulator/source/3rdparty', 'gearmulator/dsp56300', 'gearmulator/asmjit/src')
emu88_flags = common_flags + ['-DASMJIT_STATIC', '-DEMU88_STATIC', '-DEMU88_VERSION_STRING="b08ec6e"']
emu88_links = []
emu88_deps = [threads, math, cpp.find_library('dl', required: false)]
if host_machine.cpu_family() in ['x86_64', 'aarch64']
  asmjit = static_library('midi-asmjit', asmjit_sources,
    include_directories: include_directories('gearmulator/asmjit/src'),
    cpp_args: common_flags + ['-DASMJIT_STATIC'], dependencies: emu88_deps,
    gnu_symbol_visibility: 'hidden', override_options: ['warning_level=0'])
  emu88_links += asmjit
else
  emu88_flags += '-DCHIPS_FORCE_NO_JIT=1'
endif
if host_machine.system() == 'windows'
  emu88_deps += [cpp.find_library('shell32'), cpp.find_library('ole32')]
elif host_machine.system() == 'darwin'
  emu88_deps += dependency('appleframeworks', modules: ['CoreFoundation', 'AudioToolbox'])
endif
resample = static_library('midi-resample', resample_sources,
  include_directories: include_directories('gearmulator/source/3rdparty/libresample'),
  c_args: common_flags, dependencies: math, gnu_symbol_visibility: 'hidden',
  override_options: ['warning_level=0'])
emu88_links += resample
emu88 = static_library('88emu', emu88_sources, include_directories: emu88_inc,
  cpp_args: emu88_flags, dependencies: emu88_deps, link_with: emu88_links,
  gnu_symbol_visibility: 'hidden', override_options: ['warning_level=0'])
midi_dep = declare_dependency(include_directories: [spessa_inc, mu_inc, emu88_inc],
  dependencies: emu88_deps, link_with: [spessa, mu2000, emu88])
